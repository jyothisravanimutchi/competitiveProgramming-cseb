
#include <stdio.h>
#include <stdlib.h>

long long a, b;

long long gcd(long long A, long long B,
              long long *x, long long *y)
{
    if(B == 0)
    {
        *x = 1;
        *y = 0;
        return A;
    }

    long long x1, y1;

    long long d = gcd(B, A % B, &x1, &y1);

    *x = y1;
    *y = x1 - (A / B) * y1;

    return d;
}

int main()
{
    long long A, B, x, y, d;
    long long bestX, bestY;
    long long minSum = 1000000000000000000LL;

    scanf("%lld %lld", &A, &B);

    d = gcd(A, B, &x, &y);

    long long p = B / d;
    long long q = A / d;

    long long t1 = (-x) / p;
    long long t2 = y / q;

    for(long long t = t1 - 2; t <= t1 + 2; t++)
    {
        long long X = x + p * t;
        long long Y = y - q * t;

        long long sum = llabs(X) + llabs(Y);

        if(sum < minSum ||
          (sum == minSum && X <= Y &&
           bestX > bestY))
        {
            minSum = sum;
            bestX = X;
            bestY = Y;
        }
    }

    for(long long t = t2 - 2; t <= t2 + 2; t++)
    {
        long long X = x + p * t;
        long long Y = y - q * t;

        long long sum = llabs(X) + llabs(Y);

        if(sum < minSum ||
          (sum == minSum && X <= Y &&
           bestX > bestY))
        {
            minSum = sum;
            bestX = X;
            bestY = Y;
        }
    }

    printf("%lld %lld %lld\n", bestX, bestY, d);

    return 0;
}
