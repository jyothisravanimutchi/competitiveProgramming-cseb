#include <stdio.h>
#include <string.h>
int main() {
char s[100005],p[100005];
scanf("%s",s);
scanf("%s",p);
int i=0,j=0;
int star=-1,match=0;
while(s[i]!='\0')
{
if(p[j]==s[i] || p[j]=='?')
{
i++;
j++;
}
else if(p[j] == '*')
{
star = j;
match = i;
j++;
}

else if(star !=-1)
{
j=star+1;
match++;
i=match;
}
else
{
printf("0");
return 0;  
}
}  
while(p[j]=='*')
j++;
if(p[j]=='\0') 
printf("1");
else
printf("0");
return 0;
}
